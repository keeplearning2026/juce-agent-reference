    <basecompoundref refid="class_juce_1_1_reference_counted_object" prot="public">juce::ReferenceCountedObject</basecompoundref>
    <briefdescription>
      <para>Base class for audio processing plugins.</para>
    </briefdescription>
    <detaileddescription>
      <para>An AudioProcessor is the core class for creating audio plugins
      in JUCE.  It handles audio and MIDI I/O, parameter management,
      and plugin state serialisation.</para>
      <para>
        <simplesect kind="note">
          <para>All virtual methods must be called on the message thread
          unless documented otherwise.</para>
        </simplesect>
      </para>
      <para>
        <simplesect kind="warning">
          <para>Do not leak AudioProcessor instances.</para>
        </simplesect>
      </para>
    </detaileddescription>
